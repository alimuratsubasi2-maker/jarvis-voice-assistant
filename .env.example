# Bu dosyayi ".env" olarak kopyala ve gercek degerlerini gir.
# .env dosyasini asla paylasma / git'e ekleme.

# Telefon koprusu icin otomatik uretilir, dokunmana gerek yok
JARVIS_API_TOKEN=

# Ses: Gemini'nin "Charon" sesi (aistudio.google.com'dan alinan anahtar)
GEMINI_API_KEY=
GEMINI_VOICE_NAME=Charon

# Opsiyonel yedek: ElevenLabs (hesap + anahtar gerekir)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Zpbxhg6LG47cY8y5BJrf

# Ton ayari - 1.0 = orijinal, kucuk deger = daha kalin
VOICE_PITCH=1.0

# edge-tts (ucretsiz son care) ayarlari
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+15%

# Gunluk plan/hatirlatici bildirimleri (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

